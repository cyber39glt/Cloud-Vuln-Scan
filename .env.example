# Copy this file to .env (dev.ps1 does this for you on first run).
# .env is git-ignored: real values must never be committed.
# Every setting here is read by backend/app/core/config.py.

# development | test | production
APP_ENV=development

# DEBUG | INFO | WARNING | ERROR   (DEBUG is refused when APP_ENV=production)
LOG_LEVEL=INFO

# Port on your computer where the API is published (http://localhost:8000)
API_PORT=8000

# PostgreSQL. In Docker the API reaches the database at host "db"
# (set automatically by docker-compose.yml).
POSTGRES_DB=cloudscan
POSTGRES_USER=cloudscan
# Local development only. Production refuses any value starting with "change-me".
POSTGRES_PASSWORD=change-me-local-dev-only

# Seconds to wait when connecting to the database before giving up
DB_CONNECT_TIMEOUT_SECONDS=3

# Consultancy running the platform (placeholder name for development).
# Shown to clients: in the IAM role name they create and in their CloudTrail logs.
CONSULTANCY_NAME=SubtleTech

# --- AWS --------------------------------------------------------------------
# Region used for AWS STS and connection checks.
AWS_REGION=us-east-1
# Name of the read-only role clients create (must match the CloudFormation template).
AWS_ASSESSMENT_ROLE_NAME=SubtleTechSecurityAssessment
# Lifetime of temporary client credentials, in seconds (900-3600).
AWS_SESSION_DURATION_SECONDS=3600

# The PLATFORM's own AWS identity, for local development only (see
# docs/aws-connection.md). This key must belong to an IAM user whose ONLY
# permission is sts:AssumeRole on the assessment role. Never use an admin key,
# never commit real values. Leave empty until you set up your sandbox.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Azure ------------------------------------------------------------------
# The PLATFORM's own Entra application (multi-tenant), for local development only
# (see docs/azure-connection.md). The app ID is not secret; the client secret is.
# Use a short expiry (e.g. 90 days) and never commit real values.
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
